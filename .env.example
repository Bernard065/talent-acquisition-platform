# Application
APP_ENV=local
APP_NAME=talent-acquisition-api
APP_VERSION=0.1.0
API_PREFIX=/api/v1
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3002"]

# Database
POSTGRES_DB=tap
POSTGRES_USER=tap
POSTGRES_PASSWORD=local-development-password-change-me
DATABASE_URL=postgresql+asyncpg://tap:local-development-password-change-me@localhost:5432/tap

# Redis
REDIS_URL=redis://localhost:6379/0

# Object storage - local MinIO only
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=local-admin
S3_SECRET_KEY=local-development-password-change-me
S3_BUCKET=tap-documents
S3_REGION=us-east-1
S3_PRESIGNED_UPLOAD_EXPIRY_SECONDS=900

# Malware scanning and asynchronous worker
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=120
CLAMAV_MAX_STREAM_BYTES=10485760
SCAN_WORKER_POLL_INTERVAL_SECONDS=2
SCAN_WORKER_BATCH_SIZE=10
SCAN_WORKER_METRICS_PORT=9100
SCAN_WORKER_HEARTBEAT_PATH=/tmp/tap-document-scan-worker.heartbeat
SCAN_WORKER_HEARTBEAT_MAX_AGE_SECONDS=90

# Google Calendar synchronization worker.
# Start with: docker compose --profile calendar up -d calendar-sync-worker
CALENDAR_SYNC_WORKER_POLL_INTERVAL_SECONDS=5
CALENDAR_SYNC_WORKER_BATCH_SIZE=25

# Signed outbound webhooks.
# Start with: docker compose --profile webhooks up -d webhook-delivery-worker
WEBHOOK_DELIVERY_WORKER_POLL_INTERVAL_SECONDS=5
WEBHOOK_DELIVERY_WORKER_BATCH_SIZE=25
WEBHOOK_DELIVERY_TIMEOUT_SECONDS=10
WEBHOOK_ALLOWED_HOSTS=["hooks.partner.example.test",".webhooks.partner.example.test"]

# Required only when the calendar profile is enabled:
# CALENDAR_OAUTH_PROVIDER=google
# CREDENTIAL_VAULT_PROVIDER=infisical
# INFISICAL_CLIENT_ID=...
# INFISICAL_CLIENT_SECRET=...
# INFISICAL_PROJECT_ID=...
# GOOGLE_CALENDAR_OAUTH_CLIENT_ID_SECRET_NAME=tap_google_calendar_client_id
# GOOGLE_CALENDAR_OAUTH_CLIENT_SECRET_SECRET_NAME=tap_google_calendar_client_secret

# Identity provider contract
JWT_ISSUER=https://issuer.example.local/
JWT_AUDIENCE=talent-acquisition-api
JWT_JWKS_URL=http://localhost:9999/.well-known/jwks.json
JWT_ALGORITHM=RS256

# Calendar credential vault
CREDENTIAL_VAULT_PROVIDER=none
INFISICAL_HOST=https://app.infisical.com
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=dev
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=

# Calendar OAuth runtime configuration.
# Set to "google" only when Infisical contains both named secrets.
CALENDAR_OAUTH_PROVIDER=none

# Infisical secret names, not actual OAuth credentials.
# GOOGLE_CALENDAR_OAUTH_CLIENT_ID_SECRET_NAME=tap_google_calendar_client_id
# GOOGLE_CALENDAR_OAUTH_CLIENT_SECRET_SECRET_NAME=tap_google_calendar_client_secret

CALENDAR_OAUTH_HTTP_CONNECT_TIMEOUT_SECONDS=3
CALENDAR_OAUTH_HTTP_READ_TIMEOUT_SECONDS=10
JWT_LEEWAY_SECONDS=30

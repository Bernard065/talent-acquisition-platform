# Application
APP_ENV=local
APP_NAME=talent-acquisition-api
APP_VERSION=0.1.0
API_PREFIX=/api/v1
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3002"]

# Database
POSTGRES_DB=tap
POSTGRES_USER=tap
POSTGRES_PASSWORD=local-development-password-change-me
DATABASE_URL=postgresql+asyncpg://tap:local-development-password-change-me@localhost:5432/tap

# Redis
REDIS_URL=redis://localhost:6379/0

# API rate limiting. Production requires Redis and must keep rate limiting enabled.
RATE_LIMITING_ENABLED=true
RATE_LIMIT_AUTHENTICATED_REQUESTS=300
RATE_LIMIT_AUTHENTICATED_WINDOW_SECONDS=60
RATE_LIMIT_PUBLIC_READS=120
RATE_LIMIT_PUBLIC_READ_WINDOW_SECONDS=60
RATE_LIMIT_PUBLIC_APPLICATIONS=5
RATE_LIMIT_PUBLIC_APPLICATION_WINDOW_SECONDS=900
RATE_LIMIT_SIGNATURE_CALLBACKS=120
RATE_LIMIT_SIGNATURE_CALLBACK_WINDOW_SECONDS=60
RATE_LIMIT_ANONYMOUS_REQUESTS=60
RATE_LIMIT_ANONYMOUS_WINDOW_SECONDS=60

# Public job applications. Local development can use the local test adapter.
PUBLIC_APPLICATION_ABUSE_CONTROL_PROVIDER=local_allow_all

# For production, set provider=captcha, configure Infisical above, and create
# the named secret in Infisical. Never put the Turnstile secret in source control.
# PUBLIC_APPLICATION_ABUSE_CONTROL_PROVIDER=captcha
# PUBLIC_APPLICATION_CAPTCHA_SECRET_NAME=tap_public_application_turnstile_secret
# PUBLIC_APPLICATION_CAPTCHA_EXPECTED_HOSTNAMES=["careers.example.com"]
# PUBLIC_APPLICATION_CAPTCHA_EXPECTED_ACTION=public_application
# PUBLIC_APPLICATION_CAPTCHA_TIMEOUT_SECONDS=3

# Internal Prometheus scrape listener; do not publish this port publicly.
API_METRICS_PORT=9101
# Optional OpenTelemetry tracing. Configure the standard OTEL_EXPORTER_OTLP_*
# variables for your collector; do not enable until its endpoint is reachable.
TRACING_ENABLED=false
TRACING_SAMPLE_RATIO=0.10
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Configure only when requests arrive through trusted reverse proxies.
# TRUSTED_PROXY_CIDRS=["10.0.0.0/8","2001:db8::/32"]

# Object storage - local MinIO only
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=local-admin
S3_SECRET_KEY=local-development-password-change-me
S3_BUCKET=tap-documents
S3_REGION=us-east-1
S3_PRESIGNED_UPLOAD_EXPIRY_SECONDS=900

# Malware scanning and asynchronous worker
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=120
CLAMAV_MAX_STREAM_BYTES=10485760
SCAN_WORKER_POLL_INTERVAL_SECONDS=2
SCAN_WORKER_BATCH_SIZE=10
SCAN_WORKER_METRICS_PORT=9100
SCAN_WORKER_HEARTBEAT_PATH=/tmp/tap-document-scan-worker.heartbeat
SCAN_WORKER_HEARTBEAT_MAX_AGE_SECONDS=90

# Candidate privacy erasure worker; asynchronously removes resume objects.
CANDIDATE_PRIVACY_WORKER_POLL_INTERVAL_SECONDS=5
CANDIDATE_PRIVACY_WORKER_BATCH_SIZE=25
CANDIDATE_PRIVACY_WORKER_HEARTBEAT_PATH=/tmp/tap-candidate-privacy-worker.heartbeat
CANDIDATE_PRIVACY_WORKER_HEARTBEAT_MAX_AGE_SECONDS=120

# Google Calendar synchronization worker.
# Start with: docker compose --profile calendar up -d calendar-sync-worker
CALENDAR_SYNC_WORKER_POLL_INTERVAL_SECONDS=5
CALENDAR_SYNC_WORKER_BATCH_SIZE=25

# Signed outbound webhooks.
# Start with: docker compose --profile webhooks up -d webhook-delivery-worker
WEBHOOK_DELIVERY_WORKER_POLL_INTERVAL_SECONDS=5
WEBHOOK_DELIVERY_WORKER_BATCH_SIZE=25
WEBHOOK_DELIVERY_TIMEOUT_SECONDS=10
WEBHOOK_ALLOWED_HOSTS=["hooks.partner.example.test",".webhooks.partner.example.test"]

# Offer-signature dispatch worker.
# The local provider is non-production and creates deterministic test envelopes only.
# Start with:
# docker compose --profile signatures up -d offer-signature-dispatch-worker
OFFER_SIGNATURE_PROVIDER=none
# Local offer-signature callback verifier. Never enable this in production.
OFFER_SIGNATURE_CALLBACK_PROVIDER=none
# OFFER_SIGNATURE_CALLBACK_LOCAL_SIGNING_SECRET=replace-with-a-random-local-secret
OFFER_SIGNATURE_DISPATCH_WORKER_POLL_INTERVAL_SECONDS=5
OFFER_SIGNATURE_DISPATCH_WORKER_BATCH_SIZE=25

# Offer-signature expiry worker.
# Start with:
# docker compose --profile signatures up -d offer-signature-expiry-worker
OFFER_SIGNATURE_EXPIRY_WORKER_POLL_INTERVAL_SECONDS=60
OFFER_SIGNATURE_EXPIRY_WORKER_BATCH_SIZE=50

# HRIS handoff worker.
# Enable with: HRIS_HANDOFF_PROVIDER=bamboohr and
# docker compose --profile hris up -d hris-handoff-worker
HRIS_HANDOFF_PROVIDER=none

# Required only when the calendar profile is enabled:
# CALENDAR_OAUTH_PROVIDER=google
# CREDENTIAL_VAULT_PROVIDER=infisical
# INFISICAL_CLIENT_ID=...
# INFISICAL_CLIENT_SECRET=...
# INFISICAL_PROJECT_ID=...
# GOOGLE_CALENDAR_OAUTH_CLIENT_ID_SECRET_NAME=tap_google_calendar_client_id
# GOOGLE_CALENDAR_OAUTH_CLIENT_SECRET_SECRET_NAME=tap_google_calendar_client_secret

# Identity provider contract
JWT_ISSUER=https://issuer.example.local/
JWT_AUDIENCE=talent-acquisition-api
JWT_JWKS_URL=http://localhost:9999/.well-known/jwks.json
JWT_ALGORITHM=RS256

# Calendar credential vault
CREDENTIAL_VAULT_PROVIDER=none
INFISICAL_HOST=https://app.infisical.com
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=dev
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=

# Calendar OAuth runtime configuration.
# Set to "google" only when Infisical contains both named secrets.
CALENDAR_OAUTH_PROVIDER=none

# Infisical secret names, not actual OAuth credentials.
# GOOGLE_CALENDAR_OAUTH_CLIENT_ID_SECRET_NAME=tap_google_calendar_client_id
# GOOGLE_CALENDAR_OAUTH_CLIENT_SECRET_SECRET_NAME=tap_google_calendar_client_secret

CALENDAR_OAUTH_HTTP_CONNECT_TIMEOUT_SECONDS=3
CALENDAR_OAUTH_HTTP_READ_TIMEOUT_SECONDS=10
JWT_LEEWAY_SECONDS=30

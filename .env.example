# Application
APP_ENV=local
APP_NAME=talent-acquisition-api
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Database
POSTGRES_DB=tap
POSTGRES_USER=tap
POSTGRES_PASSWORD=local-development-password-change-me
DATABASE_URL=postgresql+asyncpg://tap:local-development-password-change-me@localhost:5432/tap

# Redis
REDIS_URL=redis://localhost:6379/0

# Object storage - local MinIO only
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=local-admin
S3_SECRET_KEY=local-development-password-change-me
S3_BUCKET=tap-documents
S3_REGION=us-east-1
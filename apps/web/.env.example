# Web app Auth.js session secret. Generate with `npx auth secret`.
AUTH_SECRET=

# Supabase Auth project and public client key. Never put a service_role key here.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Public origin used for Supabase password recovery redirects. Add this URL to
# Supabase Auth's Redirect URLs allow list in each environment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# FastAPI origin used by the browser API client.
NEXT_PUBLIC_API_URL=http://localhost:8000
